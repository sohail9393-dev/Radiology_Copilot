# ==============================================================================
# Radiology Copilot — Git exclusions
#
# Rule of thumb: secrets, environments, datasets, generated artifacts, and
# anything over a few MB does not belong in Git. If it can be regenerated by a
# command in the README, it belongs here, not in the repo.
# ==============================================================================

# ---------------------------- Secrets ----------------------------------------
# .env holds MYSQL_PASSWORD and GROQ_API_KEY. Commit .env.example instead.
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.pem
*.key

# ---------------------------- Virtual environments ---------------------------
.venv/
venv/
env/
ENV/
.python-version

# ---------------------------- Python caches ----------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
*.egg-info/
build/
dist/
.eggs/

# ---------------------------- Datasets ---------------------------------------
# Kaggle chest X-ray dataset (~2.4 GB). Download it separately — see README.
archive (4)/
archive/
chest_xray/
*.zip
*.tar
*.tar.gz

# ---------------------------- Vector store -----------------------------------
# Rebuilt from knowledge_base/ by ingest_knowledge.py — do not commit.
chroma_store/
*.sqlite3
*.sqlite3-journal

# ---------------------------- Model weights ----------------------------------
# Large binaries: use a GitHub Release or Git LFS if these must be shared.
*.h5
*.keras
*.pt
*.pth
*.ckpt
*.onnx
*.pkl
*.joblib

# ---------------------------- Notebooks --------------------------------------
.ipynb_checkpoints/

# ---------------------------- Tooling / patch backups ------------------------
*.dsh-backup
*.bak
*.orig
*.rej

# ---------------------------- Logs & dumps -----------------------------------
*.log
logs/
*.dump
*.sql.gz

# ---------------------------- Editor / OS ------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
