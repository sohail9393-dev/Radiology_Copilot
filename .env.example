# Copy to .env and fill in real values. NEVER commit .env or bake it into an image.
# In AWS, put these in Secrets Manager / SSM instead of a file.

# --- MySQL (docker compose creates this database for you) ---
MYSQL_DATABASE=radiology_copilot_db
MYSQL_USER=copilot_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
# Only used outside compose (compose sets MYSQL_HOST=db automatically):
MYSQL_HOST=localhost

# --- Groq (all four agents) ---
GROQ_API_KEY=gsk_your_key_here
# Optional per-agent model overrides (default: openai/gpt-oss-120b)
PLANNER_MODEL=openai/gpt-oss-120b
CORRELATION_MODEL=openai/gpt-oss-120b
CRITIC_MODEL=openai/gpt-oss-120b
SYNTHESIS_MODEL=openai/gpt-oss-120b

# --- UI -> API address (compose sets this to http://api:8000 automatically) ---
API_BASE_URL=http://127.0.0.1:8000
