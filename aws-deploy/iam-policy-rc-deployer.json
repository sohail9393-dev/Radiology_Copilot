{
  "_comment": "Least-privilege policy for rc-deployer: exactly the actions deploy.ps1 + build-and-push.ps1 need, and nothing more. Runtime permissions the container needs (secrets read) are deliberately NOT here -- they belong on the ECS execution role, not on your human user.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrReposAndPush",
      "_comment": "Create repos, push images. AuthToken is what the docker login pipe calls.",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:GetAuthorizationToken",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchCheckLayerAvailability",
        "ecr:DescribeImageScanFindings"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecretsDeployTimeOnly",
      "_comment": "Create/update secrets and read them back to verify. The container reads secrets through the ECS execution role instead.",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:PutSecretValue",
        "secretsmanager:UpdateSecret",
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue",
        "secretsmanager:DeleteSecret",
        "secretsmanager:ListSecrets"
      ],
      "Resource": "arn:aws:secretsmanager:us-east-1:885922397949:secret:rc/*"
    },
    {
      "Sid": "Ec2SecurityGroupsOnly",
      "_comment": "Security groups and subnet/AZ lookups. No instance, volume, or key-pair permissions.",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeAvailabilityZones",
        "ec2:CreateSecurityGroup",
        "ec2:DescribeSecurityGroups",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:DeleteSecurityGroup",
        "ec2:CreateTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RdsSingleInstance",
      "_comment": "Scoped by the rds:db-tag condition so this user cannot touch other databases that may exist later.",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBInstance",
        "rds:DescribeDBInstances",
        "rds:DeleteDBInstance",
        "rds:ModifyDBInstance",
        "rds:AddTagsToResource",
        "rds:ListTagsForResource"
      ],
      "Resource": "arn:aws:rds:us-east-1:885922397949:db:rc-mysql"
    },
    {
      "Sid": "LoadBalancerAndTargetGroups",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:CreateLoadBalancer",
        "elasticloadbalancing:DescribeLoadBalancers",
        "elasticloadbalancing:DeleteLoadBalancer",
        "elasticloadbalancing:CreateTargetGroup",
        "elasticloadbalancing:DescribeTargetGroups",
        "elasticloadbalancing:DeleteTargetGroup",
        "elasticloadbalancing:CreateListener",
        "elasticloadbalancing:DescribeListeners",
        "elasticloadbalancing:DeleteListener",
        "elasticloadbalancing:CreateRule",
        "elasticloadbalancing:DescribeRules",
        "elasticloadbalancing:AddTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ServiceDiscovery",
      "_comment": "Cloud Map: how the UI container resolves the API container, since awsvpc has no Docker DNS.",
      "Effect": "Allow",
      "Action": [
        "servicediscovery:CreatePrivateDnsNamespace",
        "servicediscovery:ListNamespaces",
        "servicediscovery:GetOperation",
        "servicediscovery:CreateService",
        "servicediscovery:ListServices",
        "servicediscovery:DeleteService",
        "servicediscovery:DeleteNamespace",
        "servicediscovery:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EcsDeploy",
      "Effect": "Allow",
      "Action": [
        "ecs:CreateCluster",
        "ecs:DescribeClusters",
        "ecs:DeleteCluster",
        "ecs:RegisterTaskDefinition",
        "ecs:DescribeTaskDefinition",
        "ecs:CreateService",
        "ecs:UpdateService",
        "ecs:DescribeServices",
        "ecs:DeleteService",
        "ecs:ListTasks",
        "ecs:DescribeTasks"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IamRolesForEcsTasks",
      "_comment": "Only the two rc- roles, and PassRole only to ecs-tasks.amazonaws.com via the condition -- this blocks the classic privilege-escalation path of passing a powerful role to a service.",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": "arn:aws:iam::885922397949:role/rc-*"
    },
    {
      "Sid": "PassRoleOnlyToEcsTasks",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::885922397949:role/rc-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "CloudWatchLogsForOurGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DescribeLogGroups",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:TagResource"
      ],
      "Resource": "arn:aws:logs:us-east-1:885922397949:log-group:/ecs/rc-*"
    },
    {
      "Sid": "ReadOwnLogs",
      "_comment": "Needed to debug failing tasks. Read-only, and only on our log groups.",
      "Effect": "Allow",
      "Action": [
        "logs:GetLogEvents",
        "logs:FilterLogEvents",
        "logs:DescribeLogStreams",
        "logs:StartQuery",
        "logs:GetQueryResults"
      ],
      "Resource": "arn:aws:logs:us-east-1:885922397949:log-group:/ecs/rc-*:*"
    }
  ]
}
